# Sakhi Backend Environment Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sakhi
# Fallback database URL if PostgreSQL is not locally initialized:
# DATABASE_URL=sqlite:///./sakhi.db

# AI Provider: gemini or openai
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

# Server Port
PORT=8000
