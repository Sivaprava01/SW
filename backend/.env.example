# ==============================================================================
# SAKHI INDIC FINANCIAL COMPANION — BACKEND ENVIRONMENT CONFIGURATION (.env)
# Copy this file to .env and adjust values for your local or production environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# A. Core Application & Environment
# ------------------------------------------------------------------------------
PROJECT_NAME="Sakhi"
PROJECT_DESCRIPTION="AI-Powered Indic Financial Companion Platform"
VERSION="1.0.0"
API_V1_PREFIX="/api/v1"
ENVIRONMENT="development"                      # Options: 'development', 'staging', 'production'
DEBUG=true                                     # Set to false in production
HOST="0.0.0.0"
PORT=8000

# ------------------------------------------------------------------------------
# B. Database Configuration (PostgreSQL & SQLite Fallback)
# ------------------------------------------------------------------------------
# For PostgreSQL (Recommended for production & full feature testing):
DATABASE_URL="postgresql://sakhi_user:sakhi_password@localhost:5432/sakhi_db"

# For SQLite (Frictionless local development & automated testing):
# DATABASE_URL="sqlite:///./sakhi.db"

DB_ECHO=false                                  # Set to true to log raw SQL queries
DB_POOL_SIZE=10                                # PostgreSQL connection pool size
DB_MAX_OVERFLOW=20                             # Max overflow connections beyond pool_size

# ------------------------------------------------------------------------------
# C. Security & Authentication
# ------------------------------------------------------------------------------
# Secret key used for cryptographic operations and session integrity
SECRET_KEY="sakhi-development-secret-key-change-in-production-environments"
ENABLE_SECURITY_HEADERS=true                   # Enables CSP, X-Frame-Options, HSTS headers
ALLOWED_HOSTS='["*"]'                          # Host headers allowed by the server

# ------------------------------------------------------------------------------
# D. AI / LLM Configuration (Google Gemini)
# ------------------------------------------------------------------------------
# Optional for local boot; required for live cloud AI conversational reasoning
# Get API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-lite-latest"
GEMINI_TRANSCRIBE_MODEL="gemini-3.5-transcribe"
AI_FALLBACK_MODE=true                          # When true, uses deterministic grounded rule engine if key is empty/offline


# ------------------------------------------------------------------------------
# E. Voice, Speech-to-Text & Text-to-Speech (TTS) Configuration
# ------------------------------------------------------------------------------
VOICE_TTS_PROVIDER="gtts"                      # TTS engine: 'gtts' (default with offline WAV fallback)
VOICE_CACHE_ENABLED=true                       # Cache audio byte streams on disk to reduce latency
VOICE_AUDIO_CACHE_DIR="./audio_cache"          # Directory for cached audio files
VOICE_DEFAULT_SPEED=1.0                        # Default voice playback rate (0.5 to 2.0)

# Optional Indic National Bhashini AI Pipeline credentials (for future pipeline extension)
BHASHINI_API_KEY=""
BHASHINI_USER_ID=""
BHASHINI_PIPELINE_ID=""

# ------------------------------------------------------------------------------
# F. CORS Configuration
# ------------------------------------------------------------------------------
# Allowed client origins (JSON array format)
CORS_ORIGINS='["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000", "http://127.0.0.1:3000"]'

# ------------------------------------------------------------------------------
# G. Rate Limiting & Abuse Prevention
# ------------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true                        # Enables sliding-window IP rate limiter
RATE_LIMIT_PER_MINUTE=120                      # Max requests per minute per client IP

# ------------------------------------------------------------------------------
# H. Logging & Observability
# ------------------------------------------------------------------------------
LOG_LEVEL="INFO"                               # Log level: 'DEBUG', 'INFO', 'WARNING', 'ERROR'
LOG_FORMAT="standard"                          # Format: 'standard' (human-readable) or 'json' (production aggregators)
